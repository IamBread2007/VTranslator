{
  "manifest_version": 3,
  "name": "Manga Translator",
  "description": "Dịch truyện tranh trực tiếp trên trang đọc, dùng server local.",
  "version": "0.1.0",
  "permissions": ["storage", "declarativeNetRequest", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Manga Translator — Alt+T để dịch trang" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Dịch các ảnh chưa dịch trên trang"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
